# Application
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# PostgreSQL
DATABASE_URL=REPLACE_WITH_POSTGRESQL_CONNECTION_STRING

# Solana
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=REPLACE_WITH_YOUR_SOLANA_RPC_URL

# Development wallet encryption
WALLET_ENCRYPTION_KEY=REPLACE_WITH_A_SECURE_32_BYTE_KEY_IN_HEX

# Optional external rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
